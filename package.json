{
  "name": "ls-agent",
  "description": "Plays Loot Survivor 2 on Starknet with a rule policy, with a local port of the game for practice and benchmarks",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "bench": "node scripts/bench.ts",
    "prove": "scripts/prove.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "starknet": "^10.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
