[Unit]
Description=Loot Survivor agent
After=network-online.target docker.service

[Service]
WorkingDirectory=%h/projects/ls-agent
EnvironmentFile=-%h/.config/ls-agent/env
Environment=LS_PORT=4100
Environment=LS_PACE_MS=1500
Environment=PATH=%h/.nvm/versions/node/v22.22.0/bin:%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.0/bin/node --disable-warning=ExperimentalWarning src/cli.ts start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
